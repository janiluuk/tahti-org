{
  "name": "@tahti/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./test/helpers": "./src/test/helpers.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@fastify/basic-auth": "^5.1.1",
    "@fastify/cookie": "^9.4.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tahti/audio-edit": "workspace:*",
    "@tahti/db": "workspace:*",
    "@tahti/hearthis": "workspace:*",
    "@tahti/ledger": "workspace:*",
    "@tahti/mixcloud": "workspace:*",
    "@tahti/revelator": "workspace:*",
    "@tahti/shared": "workspace:*",
    "archiver": "^8.0.0",
    "argon2": "^0.40.3",
    "bullmq": "^5.81.4",
    "esbuild": "^0.21.5",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^4.29.1",
    "fastify-plugin": "^4.5.1",
    "geoip-lite": "^2.0.3",
    "nanoid": "^5.1.16",
    "node-vibrant": "^4.0.4",
    "nodemailer": "^6.10.1",
    "otpauth": "^9.5.2",
    "redis": "^6.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^6.4.24",
    "@vitest/coverage-v8": "^1.6.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
