#!/usr/bin/env bash
# Mirrors two CI checks locally so pushes don't bounce off "Lint & format" /
# "Typecheck" for something fixable in one command.
set -uo pipefail

echo "[pre-push] Checking Prettier formatting..."
if ! pnpm format:check >/tmp/tahti-pre-push-format.log 2>&1; then
  echo
  echo "❌ Formatting issues found. Run: pnpm format"
  echo
  tail -n 20 /tmp/tahti-pre-push-format.log
  exit 1
fi

changed_files=$(git diff --name-only @{push} HEAD 2>/dev/null || git diff --name-only origin/main...HEAD 2>/dev/null)
if echo "$changed_files" | grep -qE '^(apps/api/|packages/api-client/)'; then
  echo "[pre-push] apps/api or packages/api-client changed — verifying schema.d.ts regenerates..."
  if ! pnpm --filter @tahti/api-client generate >/tmp/tahti-pre-push-schema.log 2>&1; then
    echo
    echo "❌ 'pnpm --filter @tahti/api-client generate' failed:"
    tail -n 30 /tmp/tahti-pre-push-schema.log
    exit 1
  fi
fi

echo "[pre-push] OK"
exit 0
