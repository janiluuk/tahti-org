{
  "uid": "tahti-logs",
  "title": "Tahti — logs",
  "tags": ["tahti", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Log reader for the Tahti stack containers on vimage (Loki, job=tahti). Pick services and type a search; the panels below follow both.",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki-main"
        },
        "query": {
          "label": "service",
          "stream": "{job=\"tahti\"}",
          "type": 1,
          "refId": "service"
        },
        "definition": "label_values({job=\"tahti\"}, service)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "search",
        "label": "Search (regex, case-insensitive)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by service",
      "datasource": {
        "type": "loki",
        "uid": "loki-main"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-main"
          },
          "expr": "sum by (service) (count_over_time({job=\"tahti\", service=~\"$service\"} |~ \"(?i)$search\" [$__auto]))",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors by service",
      "datasource": {
        "type": "loki",
        "uid": "loki-main"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-main"
          },
          "expr": "sum by (service) (count_over_time({job=\"tahti\", service=~\"$service\"} |~ \"(?i)(\\\\berror\\\\b|exception|fatal|panic|\\\"level\\\":(50|60))\" [$__auto]))",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Errors",
      "description": "Lines that look like errors (error, exception, fatal, panic, pino level 50/60).",
      "datasource": {
        "type": "loki",
        "uid": "loki-main"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-main"
          },
          "expr": "{job=\"tahti\", service=~\"$service\"} |~ \"(?i)(\\\\berror\\\\b|exception|fatal|panic|\\\"level\\\":(50|60))\" |~ \"(?i)$search\"",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Watchdogs and importers",
      "description": "ffmpeg watchdog kills, channel watchdog dead-air shutdowns, stuck-transcode sweeps, transcode failures, news and event imports.",
      "datasource": {
        "type": "loki",
        "uid": "loki-main"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-main"
          },
          "expr": "{job=\"tahti\"} |~ \"ffmpeg-watchdog|dead air|channel-watchdog|sweep-stuck-sound-transcodes|import-music-news|import-helsinki-music-events|transcode failed\" |~ \"(?i)$search\"",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "All logs",
      "description": "Everything from the selected services, newest first.",
      "datasource": {
        "type": "loki",
        "uid": "loki-main"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-main"
          },
          "expr": "{job=\"tahti\", service=~\"$service\"} |~ \"(?i)$search\"",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
