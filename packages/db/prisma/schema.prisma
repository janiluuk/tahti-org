  onReleasePublished Boolean        @default(false)
  onChannelLive      Boolean        @default(false)
  postTemplate       String         @default("New release: {release} by {artist} — {smart_link}")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([userId, platform])
  @@schema("core")
}

model SocialPost {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   SocialPlatform
  trigger    String
  releaseId  String?
  channelId  String?
  message    String
  state      SocialPostState @default(PENDING)
  externalId String?
  error      String?
  attempts   Int             @default(0)
  createdAt  DateTime        @default(now())
  sentAt     DateTime?

  @@index([userId, createdAt])
  @@schema("core")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("core")
}

// Personal API token — self-service, generated from /dashboard/settings/api,
// used as `Authorization: Bearer <token>` on api.tahti.live for third-party /
// scripted access (mirrors the public SDK surface). Only tokenHash is stored;
// the plaintext token is shown once at creation time. `scopes` gates write
// access — a token without "write" can only make GET/HEAD/OPTIONS requests
// (enforced in the auth plugin, not per-route) so read-only integrations
// can't be used to mutate data if leaked.
model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scopes      String[]  @default(["read"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@schema("core")
}

// 2FA: hashed one-time-use recovery codes issued when TOTP is confirmed.
model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@schema("core")
}

// 2FA: short-lived "password verified, awaiting TOTP code" pending-login state.
model TotpChallenge {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("core")
}

// One user's credential for one entry in the code-level integration-provider
// registry (packages/shared/src/integration-providers.ts) — import/export
// sources and fingerprinting providers a user installs with their own
// API key, as opposed to the OAuth-based connections which keep using their
// existing per-user token columns on User.
model IntegrationCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerSlug String
  fieldsEnc    String   // AES-GCM encrypted JSON blob of the provider's declared fields
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, providerSlug])
  @@index([userId])
  @@schema("core")
}

// PLAT-038: private WIP file storage
model StashFile {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  objectKey   String       // MinIO key
  contentType String
  sizeBytes   BigInt
  format      String?      // FLAC, WAV, MP3, ZIP, etc.
  bitDepth    Int?
  sampleRate  Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  shares      StashShare[]

  @@index([userId, createdAt(sort: Desc)])
  @@schema("core")
}

model StashShare {
  id              String     @id @default(cuid())
  fileId          String
  file            StashFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  granteeUsername String?
  token           String     @unique @default(cuid())
  permission      String     @default("READ")
  fileCount       Int        @default(1)
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())

  @@index([token])
  @@schema("core")
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@schema("core")
}

model Membership {
  id          String           @id @default(cuid())
  userId      String           @unique
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      MembershipStatus @default(PENDING_EMAIL)
  activatedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@schema("core")
}

// ── Channel schema ────────────────────────────────────────────────────────────

model Channel {
  id                 String       @id @default(cuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String       @unique
  customDomain         String?
  customDomainVerified Boolean  @default(false)
  // Solo DJ/artist vs collective/band — drives Members UI + public profile label.
  artistKind         ArtistKind   @default(SINGLE)
  state              ChannelState @default(OFFLINE)
  containerId        String?
  liveSourceMount    String
  liveSourcePass     String
  liveSourcePassHash String
  rtmpStreamKey      String
  rtmpStreamKeyHash  String
  rtmpStreamKeyPreviousHash      String? // ARTIST-002 hot rotation grace
  rtmpStreamKeyPreviousExpiresAt DateTime?
  liveSourcePassPreviousHash      String?
  liveSourcePassPreviousExpiresAt DateTime?
  webrtcTokenHash    String?
  fallbackMode       String       @default("shuffle")
  fallbackEnabled    Boolean      @default(true) // M33: explicit 24/7 rotation on/off
  // When true (default), a new track auto-joins the 24/7 rotation on upload as
  // long as MAX_FALLBACK_ITEMS isn't already reached — artist has to opt out
  // per-channel if they'd rather curate rotation manually.
  fallbackAutoEnroll Boolean      @default(true)
  // M35: whether a finished broadcast is auto-recorded to the archive. Defaults
  // to true (today's unconditional behavior) — artists opt out per-channel.
  autoRecordEnabled  Boolean      @default(true)
  // Persistent per-channel default for a new broadcast's `autoArchive` (whether
  // the recorded archive item is public once it's created) — the artist can
  // still override per-session in preflight; this just sets the starting value
  // so "always publish" doesn't need re-toggling every show.
  autoPublishBroadcast Boolean    @default(true)
  // Manage panel playlist switch: when set, the fallback rotation plays this
  // Collection's tracks (in position order) instead of the regular
  // isFallback-flagged ArchiveItem set. Null = default rotation. SetNull so
  // deleting the collection just reverts to the default rather than erroring.
  activeFallbackCollectionId String?
  activeFallbackCollection   Collection? @relation("ChannelActiveFallbackCollection", fields: [activeFallbackCollectionId], references: [id], onDelete: SetNull)
  // Whether this channel's OWN uploaded announcement clips (station-ID style)
  // get interleaved into its rotation. Default on. System-wide announcements
  // (admin-managed) are unaffected by this — they play regardless, gated only
  // by AnnouncementSettings.systemEnabled.
  announcementsEnabled Boolean @default(true)
  announcementClips    AnnouncementClip[] @relation("ChannelAnnouncementClips")
  // Optional ≤60s clip used as looping ambient music on the public artist page
  // (/u/:username). Independent of rotation `isEnabled` — SetNull if the clip
  // is deleted so the page simply goes quiet.
  profileBackgroundClipId String?          @unique
  profileBackgroundClip   AnnouncementClip? @relation("ChannelProfileBackgroundClip", fields: [profileBackgroundClipId], references: [id], onDelete: SetNull)
  totalLiveHours     Float        @default(0)
  totalListenerHours BigInt       @default(0)
  // Manage panel stats: highest concurrent-listener count ever observed, and a
  // running count of playback-start events (both bumped opportunistically —
  // see apps/api/src/routes/channels/manage-stats.ts and play-event.ts).
  listenerPeak       Int          @default(0)
  totalPlays         Int          @default(0)
  goneLiveAt         DateTime?
  metaStreamOptOut   Boolean              @default(false)
  chatSubscribersOnly Boolean             @default(false) // only active fan-subscribers can post in chat; everyone can still read
  /// Default green-room toggle for new broadcast sessions (pre-live backstage).
  greenRoomDefaultEnabled    Boolean             @default(false)
  greenRoomDefaultInvitePool GreenRoomInvitePool @default(MODERATORS_AND_SUBS)
  galleryMode        ChannelGalleryMode   @default(NONE)
  slideshowImages    String[]             // M24: ordered image URLs for channel gallery
  textLayerMode      ChannelTextLayerMode @default(NONE)
  textLayerText      String               @default("")
  textLayerAlign     ChannelTextLayerAlign @default(CENTER)
  videoBackgroundUrl String?              // M26: YouTube/Vimeo or image URL for channel backdrop
  // M31: visual customization
  colorSchemeJson    String?              // JSON {bg,accent,text,muted,highlight} hex overrides
  visualPreset       VisualPreset         @default(MINIMAL)
  // Per-preset knobs: JSON map { [VisualPreset]: { speed, intensity } }
  visualSettingsJson String?
  headerStyle        ChannelHeaderStyle   @default(GRADIENT)
  brandAccentPreset  String?              // id into BRAND_ACCENT_PRESETS (@tahti/shared); null = custom/default colorScheme
  slideshowPreset    SlideshowPreset      @default(FADE)
  slideshowIntervalSeconds Int            @default(8)
  slideshowTransitionMs    Int            @default(600)
  slideshowAutoplay        Boolean        @default(true)
  nextBroadcastAt    DateTime?            // LISTENER-002: optional next live time for offline listeners
  nextBroadcastNote  String?              // e.g. "Weekly show — Thursdays 22:00 EET"
  lastFeaturedAt     DateTime?            // M16: Tahti Radio fair rotation
  commentsEnabled    Boolean      @default(true) // initialized from User.defaultChannelCommentsEnabled
  pressKitGalleryPublic Boolean   @default(false) // show press-kit images in a public gallery on the artist page
  // When set, THIS channel's Liquidsoap process reads its live input from the
  // named channel's mount instead of its own — e.g. Tahti Radio relaying a
  // booked artist's live source during their RadioSlotBooking window. Null for
  // every regular channel; only ever set on the tahti-radio row.
  liveInputOverrideSlug String?
  // Rotation now-playing (STREAM-012): the orchestrator polls each running
  // channel's Liquidsoap telnet metadata every ~20s and resolves the current
  // track's ArchiveItem here — only meaningful while no live artist is on air,
  // since a live show's identity/artwork comes from the booking instead.
  nowPlayingTitle          String?
  nowPlayingArtistName     String?
  nowPlayingArtistUsername String?
  nowPlayingArtworkUrl     String?
  /// Source ArchiveItem.durationSec, snapshotted alongside the rest of these
  /// fields — lets a caller show remaining time without a second lookup.
  /// nowPlayingUpdatedAt doubles as "started at" (only rewritten when the
  /// resolved track actually changes, see now-playing-sync.ts).
  nowPlayingDurationSec    Int?
  nowPlayingUpdatedAt      DateTime?
  // Multistream video overlay (see buildRtmpMirrorOutput): what's baked into
  // the static video frame pushed alongside audio to YouTube/Twitch/etc.
  // mirror targets — distinct from nowPlaying* above (in-app metadata, not
  // rendered into video). Falls back to the artist's display name + avatar
  // when unset.
  streamOverlayTitle    String?
  streamOverlaySubtitle String?
  streamOverlayCoverUrl String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  archiveItems      ArchiveItem[]
  broadcasts        Broadcast[]
  liveShowSeries    LiveShowSeries[]
  scheduledLiveShows ScheduledLiveShow[]
  missedLiveShowFlags MissedLiveShowFlag[]
  announcements     ChannelAnnouncement[]
  chatBans          ChatBan[]
  chatMessages      ChatMessage[]
  moderators        ChannelModerator[]
  rtmpTargets       RtmpTarget[]
  radioFeatureLogs  RadioFeatureLog[]
  radioPlayLogs     RadioPlayLog[]
  curatedRotationItems CuratedRotationItem[]
  radioSubmissionBatches RadioTrackSubmissionBatch[]
  comments          Comment[]
  pressKitImages    PressKitImage[]
  radioSlotBookings RadioSlotBooking[]
  liveShowEpisodes LiveShowEpisode[]
  members           ChannelMember[]
  slugRedirects     ChannelSlugRedirect[]
  discoWidgetInstalls DiscoWidgetInstall[]

  @@index([state])
  @@schema("channel")
}

// A channel's previous <slug>.tahti.live address, kept reserved and
// redirecting to the channel's current slug for 30 days after a rename —
// see apps/api/src/routes/me/channel-slug.ts (write) and
// apps/api/src/routes/channels/get.ts (read/redirect resolution).
model ChannelSlugRedirect {
  id        String   @id @default(cuid())
  oldSlug   String   @unique
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([channelId])
  @@schema("channel")
}

// M36: band/project lineup shown on the artist page — a flat, freely-ordered
// list where "role" covers both actual members (Vocals, Guitar) and ad-hoc
// extra credits (Producer, Mixing House) artists want to acknowledge.
model ChannelMember {
  id         String   @id @default(cuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name       String
  role       String
  pictureUrl String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([channelId, position])
  @@schema("channel")
}

// High-quality promo photos beyond the profile avatar — used to build a
// downloadable press-kit zip (with a generated bio.txt) and, if the channel opts
// in via pressKitGalleryPublic, shown in a gallery on the public artist page.
model PressKitImage {
  id           String   @id @default(cuid())
  channelId    String
  channel      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  imageKey     String
  title        String?
  position     Int
  includeInZip Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([channelId, position])
  @@schema("channel")
}

// Tahti Radio slot booking — logged-in artists reserve an hourly window (2h max)
// to play a live set on the shared Tahti Radio channel. Only the reservation is
// tracked here (so double-booking is prevented and the calendar shows what's
// taken); the actual broadcast switch-over/fallback mechanics are separate.
model RadioSlotBooking {
  id        String            @id @default(cuid())
  channelId String
  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  note      String?
  /// Live set vs talk show — chosen when booking; seeds Broadcast.showType.
  showType  BroadcastShowType @default(LIVE_SET)
  createdAt DateTime          @default(now())
  broadcasts Broadcast[]
  episodes  LiveShowEpisode[]

  @@index([startAt, endAt])
  @@index([channelId, startAt])
  @@schema("channel")
}

model RadioFeatureLog {
  id         String   @id @default(cuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  featuredAt DateTime @default(now())

  @@index([featuredAt(sort: Desc)])
  @@schema("channel")
}

// STREAM-012 follow-up: "recently played" history — one row per distinct
// rotation-track change on a channel (not one row per now-playing-sync poll;
// the orchestrator only inserts when the resolved track actually differs from
// the last logged one). Denormalized title/artist/artwork so history still
// displays correctly even if the source ArchiveItem is later deleted.
model RadioPlayLog {
  id             String       @id @default(cuid())
  channelId      String
  channel        Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  archiveItemId  String?
  archiveItem    ArchiveItem? @relation(fields: [archiveItemId], references: [id], onDelete: SetNull)
  title          String
  artistName     String
  artistUsername String?
  artworkUrl     String?
  playedAt       DateTime     @default(now())

  @@index([channelId, playedAt(sort: Desc)])
  @@schema("channel")
}

model Broadcast {
  id            String              @id @default(cuid())
  channelId     String
  channel       Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  source        BroadcastSource
  startedAt     DateTime            @default(now())
  /// Set when this session was promoted PREVIEW -> LIVE. Null means it never went public — skip archive finalization.
  wentLiveAt    DateTime?
  endedAt       DateTime?
  recordingKey  String?
  archiveItemId String?             @unique
  /// Show name set in Broadcasting Setup step 3 (pre-flight). Falls back to a generated title if unset.
  title         String?
  /// Description copied from a scheduled show series and later used by the archive item.
  description   String?
  /// Live set vs talk show (solo or with guests).
  showType      BroadcastShowType   @default(LIVE_SET)
  /// Chronological Tahti Radio episode index when this session is for a booked slot.
  episodeNumber Int?
  /// Short editable line under the episode (seeded from RadioSlotBooking.note).
  tagline       String?
  artworkUrl    String?
  /// Booked slot this session is linked to (set when going live in the T−30m window).
  radioSlotBookingId String?
  radioSlotBooking   RadioSlotBooking? @relation(fields: [radioSlotBookingId], references: [id], onDelete: SetNull)
  scheduledLiveShowId String?           @unique
  scheduledLiveShow   ScheduledLiveShow? @relation(fields: [scheduledLiveShowId], references: [id], onDelete: SetNull)
  visibility    BroadcastVisibility @default(PUBLIC)
  autoArchive   Boolean             @default(true)
  /// Pre-live backstage: invite moderators/subscribers to hear the preview stream.
  greenRoomEnabled Boolean @default(false)
  greenRoomInvites BroadcastGreenRoomInvite[]
  reactions        BroadcastReaction[]

  @@index([channelId, startedAt(sort: Desc)])
  @@index([radioSlotBookingId])
  @@schema("channel")
}

/// Reusable defaults for an artist's recurring live programme.
model LiveShowSeries {
  id                     String              @id @default(cuid())
  channelId              String
  channel                Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  tagline                String?
  artworkUrl             String?
  showType               BroadcastShowType   @default(LIVE_SET)
  visibility             BroadcastVisibility @default(PUBLIC)
  autoArchive            Boolean             @default(true)
  episodeNumberEnabled   Boolean             @default(true)
  nextEpisodeNumber      Int                 @default(1)
  /// Preferred length for this show's radio-slot bookings (RadioSlotBooking), hours.
  intervalHours          Int                 @default(1)
  /// Freeform recurring cadence hint (e.g. "Fridays 20:00") — display only, not scheduling logic.
  scheduleNote           String?
  /// Recurring auto-scheduling: when enabled, a worker job (and an immediate
  /// pass on save) keeps ScheduledLiveShow rows generated up to
  /// recurrenceHorizonDays out, one per selected weekday, at
  /// recurrenceTimeOfDay in recurrenceTimezone.
  recurrenceEnabled      Boolean             @default(false)
  /// 0=Sunday..6=Saturday (JS Date#getDay convention).
  recurrenceDays         Int[]               @default([])
  /// 24h "HH:mm", interpreted in recurrenceTimezone.
  recurrenceTimeOfDay    String?
  recurrenceDurationMin  Int?
  /// IANA zone (e.g. "Europe/Helsinki"), captured client-side at setup time —
  /// generation is timezone/DST-aware, unlike the naive datetime-local inputs
  /// used elsewhere on this page.
  recurrenceTimezone     String?
  recurrenceHorizonDays  Int                 @default(28)
  scheduledShows         ScheduledLiveShow[]
  episodes               LiveShowEpisode[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([channelId, createdAt(sort: Desc)])
  @@schema("channel")
}

enum LiveShowEpisodeStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  LIVE

  @@schema("channel")
}

/// A show-franchise installment — distinct from ScheduledLiveShow (which announces
/// exactly when the artist's own next live broadcast is). An episode can originate
/// from an upload (never goes live at all) or be recorded from a broadcast, goes
/// through an editorial approval step, and optionally airs via a RadioSlotBooking
/// on the shared community rotation.
model LiveShowEpisode {
  id                 String                 @id @default(cuid())
  channelId          String
  channel            Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  seriesId           String
  series             LiveShowSeries         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodeNumber      Int?
  title              String
  description        String?
  artworkUrl         String?
  status             LiveShowEpisodeStatus  @default(DRAFT)
  /// Only UPLOAD / BROADCAST are valid here — narrower than ArchiveItemSource's full range.
  source             ArchiveItemSource      @default(UPLOAD)
  archiveItemId      String?
  archiveItem        ArchiveItem?           @relation(fields: [archiveItemId], references: [id], onDelete: SetNull)
  radioSlotBookingId String?
  radioSlotBooking   RadioSlotBooking?      @relation(fields: [radioSlotBookingId], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([seriesId, episodeNumber(sort: Desc)])
  @@index([channelId, createdAt(sort: Desc)])
  @@schema("channel")
}

/// A concrete occurrence. Defaults are snapshotted so later series edits do not
/// change an already announced show.
model ScheduledLiveShow {
  id            String              @id @default(cuid())
  channelId     String
  channel       Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  seriesId      String
  series        LiveShowSeries      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  startAt       DateTime
  episodeNumber Int?
  title         String
  description   String?
  tagline       String?
  venue         String?
  location      String?
  artworkUrl    String?
  showType      BroadcastShowType
  visibility    BroadcastVisibility
  autoArchive   Boolean
  canceledAt    DateTime?
  broadcast     Broadcast?
  missedFlag    MissedLiveShowFlag?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([channelId, startAt])
  @@index([seriesId, startAt])
  @@schema("channel")
}

/// Blocks a channel from booking new shows (manual scheduleLiveShowEpisode,
/// and recurrence generation) while active — see the
/// live-show-recurrence-generate cron and the show-series/episodes route,
/// both of which check for an active ban before creating a
/// ScheduledLiveShow. Distinct from ChatBan (which blocks chat, not
/// broadcasting) and from Channel.suspendedAt (a full account suspension).
enum AccountRestrictionType {
  /// Blocks scheduling new live shows — manual scheduleLiveShowEpisode and
  /// recurrence generation both check for this.
  LIVE_SHOW_BOOKING
  /// Blocks uploading new tracks/archive/release audio.
  UPLOAD
  /// Blocks signing in — checked at /api/auth/login.
  LOGIN

  @@schema("core")
}

/// A time-boxed (or indefinite) restriction an admin places on a user,
/// always with a reason shown back to the user wherever the restriction is
/// enforced. Three independent restriction types rather than one combined
/// "ban" — an admin can restrict booking without touching upload or login,
/// and vice versa. User-scoped (not channel-scoped): LOGIN clearly has to
/// be, and keeping all three on the same shape/table means one admin UI
/// pattern instead of three near-identical ones.
model AccountRestriction {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation("AccountRestrictionUser", fields: [userId], references: [id], onDelete: Cascade)
  type       AccountRestrictionType
  /// Shown to the user as the reason for the restriction.
  reason     String
  bannedAt   DateTime               @default(now())
  /// Null = indefinite, lifted manually.
  expiresAt  DateTime?
  liftedAt   DateTime?
  bannedById String?
  bannedBy   User?                  @relation("AccountRestrictionIssuedBy", fields: [bannedById], references: [id], onDelete: SetNull)

  @@index([userId, type, expiresAt])
  @@schema("core")
}

/// Raised by the missed-live-show-scan cron (apps/worker) when a
/// ScheduledLiveShow's start time passes with no Broadcast against it —
/// an admin review queue mirroring ContentReport/SupportTicket's
/// status+resolution shape (reuses ContentReportStatus rather than adding a
/// near-duplicate enum).
model MissedLiveShowFlag {
  id                  BigInt              @id @default(autoincrement())
  scheduledLiveShowId String              @unique
  scheduledLiveShow   ScheduledLiveShow   @relation(fields: [scheduledLiveShowId], references: [id], onDelete: Cascade)
  channelId           String
  channel             Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  detectedAt          DateTime            @default(now())
  status              ContentReportStatus @default(OPEN)
  resolvedById        String?
  resolvedBy          User?               @relation("MissedLiveShowFlagResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote       String?
  resolvedAt           DateTime?

  @@index([status, detectedAt(sort: Desc)])
  @@schema("admin")
}

/// Per-broadcast green room invite — access to the artist's PREVIEW stream before go-live.
model BroadcastGreenRoomInvite {
  id          String                @id @default(cuid())
  broadcastId String
  broadcast   Broadcast             @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      GreenRoomInviteSource
  invitedAt   DateTime              @default(now())
  joinedAt    DateTime?

  @@unique([broadcastId, userId])
  @@index([broadcastId])
  @@index([userId])
  @@schema("channel")
}

model ChannelAnnouncement {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([channelId, createdAt(sort: Desc)])
  @@schema("channel")
}

// Encrypted stream key stored as base64(nonce+ciphertext); key comes from
// RTMP_KEY_ENC_KEY env var (32-byte hex). plaintext key never stored unencrypted.
model RtmpTarget {
  id           String             @id @default(cuid())
  channelId    String
  channel      Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  provider     RtmpTargetProvider
  label        String
  rtmpUrl      String
  streamKeyEnc String
  alwaysMirror Boolean            @default(false)
  enabled      Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([channelId])
  @@schema("channel")
}

model ArchiveItem {
  id            String            @id @default(cuid())
  channelId     String
  channel       Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title         String
  // Overrides the displayed artist name away from channel.user.displayName —
  // for curated/compilation tracks, guest features, or when a track's credit
  // differs from the band / channel artist name. Null means use the owning
  // channel's displayName.
  artistName    String?
  // Structured role credits for this track when they differ from the channel
  // Members/Credits roster — same shape as Release.credits.
  credits       Json?             // [{ role, name, artistUsername? }]
  description   String?
  tracklist     Json?             // M22: [{startSec, title, artist?, artistUsername?}]
  editList      Json?             // Pro editor v3 draft (@tahti/audio-edit EditList v1)
  editorPeaks   Json?             // Pro editor: PeaksPyramid from ingest (PERF-04)
  bannerUrl     String?           // M24: cover image URL
  backgroundUrl String?           // per-track background image
  slideshowUrls String[]          // ordered images for track page slideshow
  galleryMode   ChannelGalleryMode @default(NONE) // preset WebGL transition for slideshowUrls
  galleryAudioReactive Boolean    @default(false) // gallery preset reacts to this track's playback
  commentary    String?           // M25: artist commentary (Markdown)
  taggedNote    String?           // draft @-mention text for collaborators
  genre         String?
  genreCustom   String?           // when not in preset genre list
  recordingLocation String?       // freeform fallback when no structured Venue is linked
  venueId       String?
  venue         Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  subGenres     String[]          @default([])
  contentType   ArchiveContentType @default(STUDIO)
  mixVersion    String?           // e.g. "Original Mix", "Rok Tek Remix"
  bpm           Int?
  musicalKey    String?
  bpmDetected   Int?
  keyDetected   String?
  useDetectedBpmKey Boolean       @default(true)
  isAiGenerated Boolean           @default(false)
  releasedAt    DateTime          @default(now())
  license       ArchiveLicense    @default(ALL_RIGHTS_RESERVED)
  repostToDownload Boolean        @default(false)
  followToDownload Boolean        @default(false)
  rawKey        String?           // null for *_EMBED sources — no audio file exists
  mp3Key        String?
  flacKey       String?
  durationSec   Int?
  sourceFormat       String?      // detected source codec, e.g. "MP3", "FLAC", "AAC", "WAV"
  sourceBitrateKbps  Int?         // detected source bitrate (lossy only); null for lossless
  peaks         Json?             // M27: per-set waveform visualisation — [0..255] amplitude buckets
  visualPreset  VisualPreset      @default(MINIMAL) // M31
  // Per-track visual override (waveform/visualizer accent color) — same shape as
  // Release/Collection: paletteJson would be auto-extracted from cover art if we
  // ever add that for tracks, colorSchemeJson is the artist's explicit override.
  paletteJson     String?
  colorSchemeJson String?
  // Artist's public "Stage" showcase (PLAT-Stage): pinned tracks/releases float to
  // the top of the profile's Stage tab, most-recently-pinned first. trackOrder is
  // the manual-sort position for the separate flat "Tracks" tab (all archive items,
  // unrelated to pinning) — same publicProfileOrder-reorder pattern as Collection.
  pinnedAt      DateTime?
  trackOrder    Int               @default(0)
  fileSizeBytes BigInt?           // null for *_EMBED sources
  source        ArchiveItemSource   @default(UPLOAD)
  qualityBadge  ArchiveQualityBadge @default(LOSSLESS)
  embedUri      String?             // spotify:track:... / mixcloud.com/.../... — present iff source is *_EMBED
  embedProvider ArchiveEmbedProvider?
  status        ArchiveItemStatus @default(PENDING)
  isPublic      Boolean           @default(true)
  isFallback           Boolean           @default(false)
  fallbackOrder        Int?              // M27: position in ordered offline rotation
  lastFallbackPlayedAt DateTime?         // M27: fair shuffle — least recent first
  selectsOptIn         Boolean           @default(false) // artist opted this track into the Tahti Selects weekly draw
  commentsEnabled      Boolean           @default(true) // initialized from User.defaultTrackCommentsEnabled
  topListsEligible     Boolean           @default(true) // initialized from !User.topListsOptOut
  hearthisExportId     String?           // remote track id once exported, for building the public hearthis.at link
  hearthisExportStatus String?           // pending | submitted | delivered | failed — same convention as Release.revelatorStatus
  hearthisExportedAt   DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  mixUpload      MixUpload?
  cloudImportJob CloudImportJob?
  collectionItems CollectionItem[]
  versions        ArchiveItemVersion[]
  curatedRotationItems CuratedRotationItem[]
  radioSubmissions     RadioTrackSubmissionItem[]
  comments        Comment[]
  likes           ArchiveItemLike[]
  reposts         ArchiveItemRepost[]
  reactions       TrackReaction[]
  listenEvents    ListenEvent[]
  radioPlayLogs   RadioPlayLog[]
  stemJobs        ArchiveItemStemJob[]
  liveShowEpisodes LiveShowEpisode[]

  @@index([channelId, createdAt(sort: Desc)])
  @@index([channelId, isPublic, status])
  @@schema("channel")
}

enum StemSet {
  TWO_STEM // vocals + instrumental
  FOUR_STEM // vocals + drums + bass + other

  @@schema("channel")
}

enum StemJobStatus {
  PENDING
  PROCESSING
  READY
  ERROR

  @@schema("channel")
}

// Vocal/instrument separation (UVR5-family models via the stem-separator
// service) for a library track's "Download stems" option. Rendered
// on-demand from the archive item's own rawKey/flacKey (never re-derived
// from a lossy mp3Key when a better source exists) and auto-expired ~7
// days after READY — see sweep-expired-stems cron — rather than kept
// forever, since there's no per-user quota headroom carved out for this.
model ArchiveItemStemJob {
  id            String         @id @default(cuid())
  archiveItemId String
  archiveItem   ArchiveItem    @relation(fields: [archiveItemId], references: [id], onDelete: Cascade)
  requestedById String
  stemSet       StemSet
  status        StemJobStatus  @default(PENDING)
  vocalsKey       String?
  instrumentalKey String? // TWO_STEM only
  drumsKey        String? // FOUR_STEM only
  bassKey         String? // FOUR_STEM only
  otherKey        String? // FOUR_STEM only
  errorMessage  String?
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([archiveItemId, stemSet])
  @@index([expiresAt])
  @@schema("channel")
}

// A short pre-mixed audio clip (station-ID / announcement) interleaved into a
// channel's rotation. channelId null = system-wide, admin-managed, played
// into every channel's rotation subject to AnnouncementSettings.systemEnabled
// and this clip's own isEnabled + scheduleMode. channelId set = one artist's
// own library, played subject to Channel.announcementsEnabled — always
// RANDOM-ish spacing, no configurable schedule (scheduleMode/everyNth are
// ignored for these). No mp3Key/flacKey pair like ArchiveItem — a single
// audioKey is enough, since Liquidsoap only ever needs one resolvable file
// per playlist row (see packages/shared/src/archive-playback.ts).
model AnnouncementClip {
  id           String                   @id @default(cuid())
  channelId    String?
  channel      Channel?                 @relation("ChannelAnnouncementClips", fields: [channelId], references: [id], onDelete: Cascade)
  title        String
  audioKey     String
  // Never overwritten after upload — the trim editor always re-renders from
  // this file (not from a previous trim), so edits stay non-destructive and
  // the editor can always offer an "original" preview to A/B against.
  originalAudioKey String
  durationSec  Int?
  isEnabled    Boolean                  @default(true)
  scheduleMode AnnouncementScheduleMode @default(RANDOM)
  everyNth     Int?
  position     Int                      @default(0)
  // Trim-editor render state — READY means audioKey points at a playable
  // file right now; PROCESSING means a worker job is baking a trim/fade
  // edit and audioKey still points at the last-good file until it flips
  // back to READY (or ERROR, on failure — audioKey is left untouched).
  renderStatus AnnouncementRenderStatus @default(READY)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  // Inverse of Channel.profileBackgroundClip — at most one channel can point here.
  profileBackgroundFor Channel?         @relation("ChannelProfileBackgroundClip")

  @@index([channelId])
  @@schema("channel")
}

// Singleton row (id always "global") — the admin kill-switch for the entire
// system-announcements feature, independent of individual clips' isEnabled.
model AnnouncementSettings {
  id            String   @id @default("global")
  systemEnabled Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@schema("channel")
}

// M28: audio file versions for a single archive track (stable public item id).
model ArchiveItemVersion {
  id            String            @id @default(cuid())
  archiveItemId String
  archiveItem   ArchiveItem       @relation(fields: [archiveItemId], references: [id], onDelete: Cascade)
  versionNumber Int
  versionLabel  String
  rawKey        String
  mp3Key        String?
  flacKey       String?
  durationSec   Int?
  sourceFormat       String?      // detected source codec, e.g. "MP3", "FLAC", "AAC", "WAV"
  sourceBitrateKbps  Int?         // detected source bitrate (lossy only); null for lossless
  peaks         Json?             // M27: per-set waveform visualisation — [0..255] amplitude buckets
  fileSizeBytes BigInt            @default(0)
  status        ArchiveItemStatus @default(PENDING)
  isActive      Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@unique([archiveItemId, versionNumber])
  @@index([archiveItemId, createdAt(sort: Desc)])
  @@schema("channel")
}

// Curated, admin-programmed rotation for a channel (e.g. "Tahti Selects") — a thin
// reference list pointing at ArchiveItems wherever they live (own channel or another
// artist's already-public archive), so the same audio file is never duplicated.
// Distinct from the per-artist ArchiveItem.isFallback/fallbackOrder offline rotation:
// that's one artist's own archive; this is a curated cross-channel playlist for a
// single admin-managed channel. See docs/planning-decisions.md (Tahti Selects).
model CuratedRotationItem {
  id            String      @id @default(cuid())
  channelId     String
  channel       Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  archiveItemId String
  archiveItem   ArchiveItem @relation(fields: [archiveItemId], references: [id], onDelete: Cascade)
  position      Int
  addedById     String
  addedBy       User        @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([channelId, archiveItemId])
  @@index([channelId, position])
  @@schema("channel")
}

/// Artist submits up to 5 READY archive tracks at once for Tahti Radio audit.
model RadioTrackSubmissionBatch {
  id          String                     @id @default(cuid())
  submitterId String
  submitter   User                       @relation("RadioSubmissionSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  channelId   String
  channel     Channel                    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  note        String?
  createdAt   DateTime                   @default(now())
  items       RadioTrackSubmissionItem[]

  @@index([createdAt(sort: Desc)])
  @@index([submitterId, createdAt(sort: Desc)])
  @@schema("channel")
}

model RadioTrackSubmissionItem {
  id              String                @id @default(cuid())
  batchId         String
  batch           RadioTrackSubmissionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  archiveItemId   String
  archiveItem     ArchiveItem           @relation(fields: [archiveItemId], references: [id], onDelete: Cascade)
  positionInBatch Int
  status          RadioSubmissionStatus @default(PENDING)
  rejectionNote   String?
  reviewedById    String?
  reviewedBy      User?                 @relation("RadioSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())

  @@unique([batchId, archiveItemId])
  @@index([status, createdAt(sort: Desc)])
  @@index([archiveItemId, status])
  @@schema("channel")
}

// ── Chat schema ───────────────────────────────────────────────────────────────

model ChatBan {
  id              String   @id @default(cuid())
  channelId       String
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  fingerprintHash String
  bannedAt        DateTime @default(now())

  @@unique([channelId, fingerprintHash])
  @@index([channelId, bannedAt])
  @@schema("chat")
}

/// Permanent record of chat messages — Centrifugo's own history is a 1h
/// rolling in-memory buffer with no persistence, so this is the durable
/// source of truth. Written once, on the server, when a message clears
/// moderation in routes/chat/message.ts (Centrifugo's publish proxy) — never
/// by the client directly. System-generated messages (e.g. "X loved Y" love
/// announcements) are published straight to Centrifugo by the API and don't
/// go through that proxy, so they aren't captured here.
model ChatMessage {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// True for the subscriber-only ":fans" sub-channel, false for the main chat.
  fanOnly     Boolean  @default(false)
  handle      String
  text        String
  userId      String?
  supporter   Boolean  @default(false)
  channelRole String?
  countryCode String?
  createdAt   DateTime @default(now())

  @@index([channelId, fanOnly, createdAt])
  @@schema("chat")
}

// M27: trusted listeners delegated chat moderation (ban/unban) by the channel owner
model ChannelModerator {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())

  @@unique([channelId, userId])
  @@index([userId])
  @@schema("chat")
}

// ── Ledger schema (append-only) ───────────────────────────────────────────────

model LedgerEntry {
  id           BigInt          @id @default(autoincrement())
  category     LedgerCategory
  amountCents  BigInt
  currency     String          @default("EUR")
  description  String
  externalRef  String?
  periodStart  DateTime
  periodEnd    DateTime
  createdAt    DateTime        @default(now())
  createdBy    String

  @@index([category, periodStart])
  @@index([createdAt])
  @@schema("ledger")
}

model MonthlyRollup {
  yearMonth   String   @id
  byCategory  Json
  surplus     BigInt
  finalizedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("ledger")
}

// M9 — annual engagement-unit-weighted grant disbursements. One row per
// eligible artist per fiscal year. Append-only in spirit: a finalized year's
// rows are not recomputed (see docs/planning-decisions.md Topic 8).
model GrantDisbursement {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  forYear      Int
  units        Int
  amountCents  BigInt
  state        GrantState @default(PENDING)
  payoutMethod String?
  payoutRef    String?
  notifiedAt   DateTime?
  confirmedAt  DateTime?
  paidAt       DateTime?
  publishedAs  String
  createdAt    DateTime   @default(now())

  @@unique([userId, forYear])
  @@index([forYear])
  @@schema("ledger")
}

// ── Governance schema ─────────────────────────────────────────────────────────

model AuditLog {
  id         BigInt      @id @default(autoincrement())
  action     AuditAction
  actorId    String
  targetId   String?
  meta       Json?
  createdAt  DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@schema("governance")
}

// ── Member governance (M10) ───────────────────────────────────────────────────
// Voting is ADVISORY for Y1 (see docs/planning-decisions.md Topic 11). Binding
// AGM decisions require a live meeting until the bylaws authorize asynchronous
// electronic voting; `advisory` flips to false once that clause is filed.

model Motion {
  id          String      @id @default(cuid())
  title       String
  description String
  proposedBy  String
  proposer    User        @relation(fields: [proposedBy], references: [id])
  advisory    Boolean     @default(true)
  openAt      DateTime
  closeAt     DateTime
  state       MotionState @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  votes    Vote[]
  comments MotionComment[]

  @@index([state, closeAt])
  @@schema("governance")
}

model Vote {
  motionId String
  motion   Motion     @relation(fields: [motionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice   VoteChoice
  castAt   DateTime   @default(now())

  @@id([motionId, userId])
  @@index([motionId])
  @@schema("governance")
}

/// Discussion thread on a Motion — the "Discussion · 7-day circulation" DRAFT-state
/// label implied this existed but it never did (found in the 2026-07-08 governance
/// E2E audit). Mirrors SupportTicketNote's shape: flat chronological list, no
/// edit/soft-delete, author kept nullable so deleting a user doesn't cascade-delete
/// their comments (their contribution to the discussion record persists).
model MotionComment {
  id        BigInt   @id @default(autoincrement())
  motionId  String
  motion    Motion   @relation(fields: [motionId], references: [id], onDelete: Cascade)
  body      String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([motionId, createdAt(sort: Asc)])
  @@schema("governance")
}

enum FeatureRequestStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
  DUPLICATE

  @@schema("governance")
}

/// Member-suggested feature board: propose, vote, discuss. Reviewed quarterly by
/// the board (see FeatureRequestQuarterlyReport) — status moves to PLANNED/
/// IN_PROGRESS/DONE/DECLINED, or DUPLICATE with mergedInto pointing at the
/// original so duplicate suggestions consolidate their votes/discussion there.
model FeatureRequest {
  id           String               @id @default(cuid())
  title        String
  description  String
  proposedById String
  proposedBy   User                 @relation("FeatureRequestProposer", fields: [proposedById], references: [id], onDelete: Cascade)
  status       FeatureRequestStatus @default(OPEN)
  mergedIntoId String?
  mergedInto   FeatureRequest?      @relation("FeatureRequestDuplicateOf", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  duplicates   FeatureRequest[]     @relation("FeatureRequestDuplicateOf")
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?                @relation("FeatureRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  // Stamped the quarter a request first moves to PLANNED/IN_PROGRESS/DONE —
  // the "voted in" record the quarterly report reads from.
  votedInYear    Int?
  votedInQuarter Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  votes    FeatureRequestVote[]
  comments FeatureRequestComment[]

  @@index([status, createdAt])
  @@schema("governance")
}

model FeatureRequestVote {
  featureRequestId String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@id([featureRequestId, userId])
  @@index([featureRequestId])
  @@schema("governance")
}

/// Mirrors MotionComment's shape (flat, nullable author) for the same reason —
/// deleting a user shouldn't erase their contribution to the discussion record.
model FeatureRequestComment {
  id               BigInt         @id @default(autoincrement())
  featureRequestId String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  body             String
  authorId         String?
  author           User?          @relation("FeatureRequestCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())

  @@index([featureRequestId, createdAt(sort: Asc)])
  @@schema("governance")
}

// ── Engagement (M18) ──────────────────────────────────────────────────────────
// Every download is logged for grant accounting. A row that counts toward grants
// has `countedAt` set and a `weight` (1 free, 5 fan-subscriber). Rows that don't
// count (dedup, per-track cap, fraud) keep countedAt NULL with a `reason`.
// See docs/engagement-and-fansubs.md.

model Download {
  id             BigInt    @id @default(autoincrement())
  channelId      String
  archiveItemId  String?
  releaseTrackId String?
  format         String
  byUserId       String?
  byFingerprint  String
  byIpHash       String
  countryCode    String?
  bytes          Int       @default(0)
  countedAt      DateTime?
  reason         String?
  weight         Int       @default(1)
  createdAt      DateTime  @default(now())

  @@index([channelId, countedAt])
  @@index([channelId, createdAt(sort: Desc)])
  @@index([byFingerprint, archiveItemId])
  @@index([archiveItemId, createdAt])
  @@index([byIpHash, createdAt])
  @@index([countedAt])
  @@schema("engagement")
}

// M22: artist follow/subscribe — also unlocks follow-gated downloads, drives the
// NEW_TRACK/NEW_POST notification fan-out, and (M40) is a real subscribe button
// on the channel/profile page, not just a download-gate side effect anymore.
model ArtistFollow {
  followerUserId String
  artistUserId   String
  follower       User     @relation("ArtistFollowing", fields: [followerUserId], references: [id], onDelete: Cascade)
  artist         User     @relation("ArtistFollowers", fields: [artistUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@id([followerUserId, artistUserId])
  @@index([artistUserId])
  @@schema("engagement")
}

// M40: a listener "loving" a track — powers the heart/like button on track rows
// and the NEW_LIKE notification to the artist.
model ArchiveItemLike {
  userId        String
  archiveItemId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  archiveItem   ArchiveItem @relation(fields: [archiveItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([userId, archiveItemId])
  @@index([archiveItemId])
  @@schema("engagement")
}

// A listener reposting/sharing a track — distinct from ArchiveRepostAck (an
// acknowledgment gating a download, unrelated to sharing). Powers the repost
// button on track rows, the Manage panel's Reposts stat, and the NEW_REPOST
// notification to the artist.
model ArchiveItemRepost {
  userId        String
  archiveItemId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  archiveItem   ArchiveItem @relation(fields: [archiveItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([userId, archiveItemId])
  @@index([archiveItemId])
  @@schema("engagement")
}

// A listener reacting to a specific moment in a track — pinned to the waveform
// position it was left at (positionSec), shown to every listener as a subtly
// animated marker. Distinct from ArchiveItemLike: a user may leave many of
// these on the same track (different types, different timestamps), and a
// LOVE reaction additionally posts a "{user} loved {track}" chat message
// (see routes/reactions/track.ts).
model TrackReaction {
  id            String            @id @default(cuid())
  archiveItemId String
  archiveItem   ArchiveItem       @relation(fields: [archiveItemId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TrackReactionType
  positionSec   Float
  createdAt     DateTime          @default(now())

  @@index([archiveItemId, positionSec])
  @@schema("engagement")
}

/// Flying-emoji reactions fired during a LIVE broadcast (routes/chat/react.ts,
/// ReactionsOverlay) — anonymous-friendly and channel/show-wide, unlike
/// TrackReaction above (signed-in, anchored to a specific archived track's
/// playback position). elapsedSec is seconds since the broadcast's
/// wentLiveAt/startedAt, computed once at write time, so replaying them
/// during archive playback later is a direct lookup, not a recomputation.
/// Broadcast.archiveItemId links a finished broadcast to its recording, so
/// a reaction can be looked up either live (by broadcastId) or on replay
/// (by resolving the archive item back to its broadcast).
model BroadcastReaction {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  emoji       String
  elapsedSec  Float
  createdAt   DateTime  @default(now())

  @@index([broadcastId, elapsedSec])
  @@schema("engagement")
}

// A countable listen, powering top-lists ranking. One row per (track,
// listener, calendar day) — dedupeKey is the userId when logged in, else a
// server-side hash of IP+UA, so the unique constraint below stops a single
// listener from inflating a track's count by replaying/refreshing.
// archiveItem-only for now: releases aren't tracked here since they aren't
// played through a mechanism that reports playback progress yet.
model ListenEvent {
  id            String      @id @default(cuid())
  archiveItemId String
  archiveItem   ArchiveItem @relation(fields: [archiveItemId], references: [id], onDelete: Cascade)
  dedupeKey     String
  dayBucket     String
  playedAt      DateTime    @default(now())

  @@unique([archiveItemId, dedupeKey, dayBucket])
  @@index([archiveItemId, playedAt])
  @@index([playedAt])
  @@schema("engagement")
}

// ── Private messaging (M38) ───────────────────────────────────────────────────
// 1:1 conversations only (participants is a join table so group DMs could be
// added later without a redesign, but nothing today creates a Conversation
// with more than 2 participants).

model Conversation {
  id           String                     @id @default(cuid())
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  @@schema("engagement")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@schema("engagement")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@schema("engagement")
}

// Comments on a track (ArchiveItem) or a channel — exactly one of archiveItemId /
// channelId is set per row (enforced in the API, not the DB). Posting is blocked
// when the target's commentsEnabled is false; existing comments are left in place
// (toggling off just stops new ones, it isn't a moderation wipe).
model Comment {
  id            String       @id @default(cuid())
  body          String
  authorId      String
  author        User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  archiveItemId String?
  archiveItem   ArchiveItem? @relation(fields: [archiveItemId], references: [id], onDelete: Cascade)
  channelId     String?
  channel       Channel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([archiveItemId, createdAt])
  @@index([channelId, createdAt])
  @@schema("engagement")
}

// M22: listener acknowledged sharing (repost-gated downloads).
model ArchiveRepostAck {
  id            String   @id @default(cuid())
  archiveItemId String
  byUserId      String?
  byFingerprint String
  createdAt     DateTime @default(now())

  @@unique([archiveItemId, byFingerprint])
  @@index([archiveItemId])
  @@schema("engagement")
}

// ── Fan-to-artist subscriptions (M19) ─────────────────────────────────────────
// Listeners subscribe directly to an artist. Money flows to the artist via
// Stripe Connect minus Stripe fees and a 2% operational fee (passthrough, not
// org revenue — bylaws §11.b). Fan-sub euros and 5× paid-download weighting feed
// the M9 grant formula. See docs/engagement-and-fansubs.md.

model FanTier {
  id           String   @id @default(cuid())
  artistUserId String
  artist       User     @relation(fields: [artistUserId], references: [id], onDelete: Cascade)
  name         String
  amountCents  Int
  description  String?
  perks        String[]
  active       Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([artistUserId, active])
  @@schema("fansubs")
}

model FanSubscription {
  id                   String      @id @default(cuid())
  artistUserId         String
  subscriberUserId     String
  artist               User        @relation("ArtistFanSubs", fields: [artistUserId], references: [id], onDelete: Cascade)
  subscriber           User        @relation("SubscriberFanSubs", fields: [subscriberUserId], references: [id], onDelete: Cascade)
  tierName             String
  amountCents          Int
  stripeSubscriptionId String      @unique
  state                FanSubState @default(ACTIVE)
  startedAt            DateTime    @default(now())
  currentPeriodEnd     DateTime
  canceledAt           DateTime?
  createdAt            DateTime    @default(now())

  payouts FanSubPayout[]

  @@unique([artistUserId, subscriberUserId])
  @@index([artistUserId, state])
  @@index([subscriberUserId, state])
  @@index([state])
  @@schema("fansubs")
}

model FanSubPayout {
  id                String            @id @default(cuid())
  fanSubscriptionId String
  fanSubscription   FanSubscription   @relation(fields: [fanSubscriptionId], references: [id], onDelete: Cascade)
  artistUserId      String
  forPeriodStart    DateTime
  forPeriodEnd      DateTime
  grossCents        Int
  stripeFeeCents    Int
  orgFeeCents       Int
  netToArtistCents  Int
  stripeTransferId  String?
  state             FanSubPayoutState @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime          @default(now())

  @@index([fanSubscriptionId, forPeriodStart])
  @@index([artistUserId, forPeriodStart])
  @@index([artistUserId, state, paidAt])
  @@index([state, createdAt])
  @@schema("fansubs")
}

// ── Artist profile releases (M12 + M7 distribution) ────────────────────────

model Release {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  type             ReleaseType
  artworkUrl       String?
  artworkKey       String?      // M12: cover image in MinIO (presigned for public URLs)
  releaseDate      DateTime
  description      String?
  genre            String?
  genreCustom      String?      // when not in preset genre list
  smartLinkSlug    String       @unique
  smartLinkTargets Json?        // {spotify, apple, tidal, bandcamp, ...}
  smartLinkViewCount Int        @default(0) // M14: public /r/:slug loads
  state            ReleaseState @default(DRAFT)
  publishedAt      DateTime?
  commentary       String?      // M25: artist notes on the release (Markdown)
  // M7 — Revelator DSP distribution
  revelatorId      String?
  revelatorStatus  String?      // pending | submitted | delivered | failed
  distributionFeeCents Int?
  distributionPaidAt   DateTime?
  distributionStripeSessionId String? @unique
  // M30 — release ops / catalog metadata
  upc                    String?
  musicbrainzReleaseId   String?
  musicbrainzArtistId    String?
  discogsReleaseId       String?
  pLine                  String?
  cLine                  String?
  labelImprint           String?
  credits                Json?    // [{ role, name, artistUsername? }]
  // M31: visual customization
  paletteJson      String?      // extracted from cover art: JSON {bg,accent,text,muted,highlight}
  colorSchemeJson  String?      // artist-override JSON {bg,accent,text,muted,highlight}
  visualPreset     VisualPreset @default(MINIMAL)
  slideshowImages  String[]           // ordered images for release page slideshow
  galleryMode      ChannelGalleryMode @default(NONE) // preset WebGL transition for slideshowImages
  galleryAudioReactive Boolean       @default(false) // gallery preset reacts to this release's playback
  // Artist's public "Stage" showcase: pinned releases float to the top of the
  // profile's Stage tab, most-recently-pinned first — same mechanism as ArchiveItem.pinnedAt.
  pinnedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tracks           ReleaseTrack[]
  collectionItems  CollectionItem[]
  revelatorRoyaltyReports RevelatorRoyaltyReport[]
  smartLinkClicks  SmartLinkClick[]

  @@index([userId, releaseDate])
  @@index([userId, state])
  @@schema("release")
}

model SmartLinkClick {
  id        String   @id @default(cuid())
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  platform  String
  referer   String?
  createdAt DateTime @default(now())

  @@index([releaseId, platform])
  @@index([releaseId, createdAt])
  @@schema("release")
}

// M7 — Revelator royalty report snapshots (monthly sync, dashboard display)
model RevelatorRoyaltyReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  releaseId   String
  release     Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  revelatorId String
  periodStart DateTime
  periodEnd   DateTime
  amountCents Int
  currency    String   @default("EUR")
  streams     Int?
  syncedAt    DateTime @default(now())

  @@unique([releaseId, periodStart, periodEnd])
  @@index([userId, periodEnd(sort: Desc)])
  @@schema("release")
}

model ReleaseTrack {
  id               String      @id @default(cuid())
  releaseId        String
  release          Release     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  position         Int
  title            String
  isrc             String?
  musicbrainzRecordingId String?
  durationSec      Int?
  archiveItemId    String?
  genre            String?
  genreCustom      String?     // when not in preset genre list
  credits          Json?       // per-song credits [{ role, name, artistUsername? }], distinct from Release.credits
  // M12 — audio file pipeline
  sourceKey        String?     // original uploaded file in MinIO
  sourceFormat     String?     // wav | flac | mp3 | aac | aiff
  sourceSampleRate Int?
  sourceBitDepth   Int?
  streamKey        String?     // Opus 256 kbps derivative
  flacKey          String?     // FLAC 16/44 derivative (Studio tier download)
  fingerprint      String?     // Chromaprint fingerprint (base64), generated on upload
  // AcoustID lookup result against `fingerprint`, generated automatically on upload —
  // { acoustidId, score, recordingId?, title?, artist? } (see AcoustidFullMatch in
  // @tahti/shared). Null while pending/unmatched. This is the raw candidate match;
  // musicbrainzRecordingId above is only set once the artist confirms/registers it.
  fingerprintMatch Json?
  explicit         Boolean     @default(false)
  status           TrackStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  // Mirrors the active ReleaseTrackVersion's R2 fields (see syncActiveVersionToTrack).
  r2Key            String?
  r2SizeBytes      Int?

  versions         ReleaseTrackVersion[]

  @@unique([releaseId, position])
  @@schema("release")
}

// M28: audio file versions for a release track (stable public track id).
model ReleaseTrackVersion {
  id               String      @id @default(cuid())
  releaseTrackId   String
  releaseTrack     ReleaseTrack @relation(fields: [releaseTrackId], references: [id], onDelete: Cascade)
  versionNumber    Int
  versionLabel     String
  sourceKey        String
  sourceFormat     String?
  sourceSampleRate Int?
  sourceBitDepth   Int?
  streamKey        String?
  flacKey          String?
  durationSec      Int?
  status           TrackStatus @default(PENDING)
  isActive         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  // R2 long-term mirror of the original (lossless) upload — null until the
  // transcode worker writes it through, and null again once retention GC
  // purges it (see storage-quota.ts / [[hosting-decisions]]: only the most
  // recent 4 versions per track keep an R2 copy).
  r2Key            String?
  r2SizeBytes      Int?

  @@unique([releaseTrackId, versionNumber])
  @@index([releaseTrackId, createdAt(sort: Desc)])
  @@schema("release")
}

// M7 — Mixcloud upload for archive items (mixes)
model MixUpload {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  archiveItemId String          @unique
  archiveItem   ArchiveItem     @relation(fields: [archiveItemId], references: [id])
  mixcloudUrl   String?
  mixcloudKey   String?
  status        MixUploadStatus @default(PENDING)
  error         String?
  queuedAt      DateTime        @default(now())
  completedAt   DateTime?

  @@schema("release")
}

// ── Newsletter schema (M13) ──────────────────────────────────────────────────

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  artistUserId   String
  artist         User      @relation("ArtistSubscribers", fields: [artistUserId], references: [id], onDelete: Cascade)
  email          String
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  confirmToken   String?   @unique
  unsubToken     String    @unique
  createdAt      DateTime  @default(now())

  sends NewsletterSend[]

  @@unique([artistUserId, email])
  @@index([artistUserId, confirmedAt])
  @@schema("newsletter")
}

model NewsletterDraft {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  bodyMd      String
  state            NewsletterDraftState @default(DRAFT)
  subscribersOnly  Boolean              @default(false) // M19: send only to fan-subscribers
  scheduledAt      DateTime?
  sentAt           DateTime?
  createdAt   DateTime             @default(now())

  sends NewsletterSend[]

  @@index([userId, state])
  @@schema("newsletter")
}

model NewsletterSend {
  id           String              @id @default(cuid())
  draftId      String
  draft        NewsletterDraft     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  state        NewsletterSendState @default(QUEUED)
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  createdAt    DateTime            @default(now())

  @@index([draftId, state])
  @@schema("newsletter")
}

// ── Venue schema (M17) ───────────────────────────────────────────────────────

model Venue {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  address       String
  city          String
  countryCode   String    @default("FI")
  latitude      Float?
  longitude     Float?
  capacity      Int?
  description   String?
  externalLinks Json?
  photos        String[]
  verifiedAt    DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())

  broadcasts   VenueBroadcast[]
  archiveItems ArchiveItem[]

  @@index([createdBy])
  @@schema("venue")
}

model VenueBroadcast {
  id           String              @id @default(cuid())
  venueId      String
  venue        Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  artistUserId String
  startAt      DateTime
  endAt        DateTime?
  description  String?
  channelId    String?
  state        VenueBroadcastState @default(SCHEDULED)
  createdAt    DateTime            @default(now())

  @@index([venueId, startAt])
  @@index([artistUserId, startAt])
  @@schema("venue")
}

// ── In-app notifications ──────────────────────────────────────────────────────
// Generic recipient inbox — currently only NEW_POST (follower notified when an
// artist they follow publishes), designed to grow into other types (e.g. new
// direct message) without a schema change.

model Notification {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  actorUserId String?
  actor       User?             @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  title       String
  body        String?
  url         String?
  readAt      DateTime?
  /// Surfaced in a separate must-dismiss banner (see StickyNotificationBanner)
  /// instead of the ordinary bell dropdown — opening the bell does NOT mark
  /// these read, only an explicit per-notification dismiss does.
  sticky      Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@schema("core")
}

// ── Artist @-mentions (M15) ──────────────────────────────────────────────────

model Mention {
  id              String         @id @default(cuid())
  mentionerUserId String
  mentioner       User           @relation("MentionerMentions", fields: [mentionerUserId], references: [id], onDelete: Cascade)
  targetUserId    String
  target          User           @relation("MentionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  surface         MentionSurface
  sourceId        String         // bio userId | announcement id | release id | draft id
  notifiedAt      DateTime?
  createdAt       DateTime       @default(now())

  @@unique([mentionerUserId, targetUserId, surface, sourceId])
  @@index([targetUserId, notifiedAt])
  @@schema("core")
}

model MentionMute {
  muterId      String
  muter        User    @relation("MuterMutes", fields: [muterId], references: [id], onDelete: Cascade)
  targetUserId String
  target       User    @relation("MuteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@id([muterId, targetUserId])
  @@schema("core")
}

// ── Collections + catalog UX (M23) ───────────────────────────────────────────

model Collection {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String         @unique
  name        String
  description String?
  type        CollectionType @default(CUSTOM)
  isPublic    Boolean        @default(true)
  isFeatured  Boolean        @default(false) // M23: highlight on profile + smart links
  // When true (and isPublic), any logged-in user can add an archive item to this
  // playlist — a collaborative-playlist toggle. Only meaningful for style=PLAYLIST;
  // adding archive items only, never releases (a release isn't "an artist's own
  // track" to contribute the way a single archive item is).
  collaborative Boolean      @default(false)
  coverUrl    String?
  // MinIO object key when the cover was uploaded through our own flow (cover.ts) —
  // resolved to a presigned URL at read time (resolveCollectionCoverUrl) instead of
  // relying on public bucket read, since covers aren't gated by isPublic at upload
  // time and a private ("Vault") collection's cover must not be guessable by URL.
  // Null for externally-linked cover images, which stay served from coverUrl as-is.
  coverKey    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Sprint 9: upload + collections flow
  style              CollectionStyle      @default(PLAYLIST)
  visibility         CollectionVisibility @default(PUBLIC)
  coverMode          CollectionCoverMode  @default(AUTO)
  publicProfileOrder Int                  @default(0)
  scheduledPublishAt DateTime?
  smartLinksJson     Json?
  trackSortMode      CollectionTrackSortMode @default(MANUAL)

  // M26: per-collection backdrop theme (independent of the channel-wide theme)
  galleryMode        CollectionGalleryMode     @default(NONE)
  slideshowImages    String[]
  videoBackgroundUrl String?
  textLayerMode      CollectionTextLayerMode   @default(NONE)
  textLayerText      String                    @default("")
  textLayerAlign     CollectionTextLayerAlign  @default(CENTER)

  // Mood/color editor — same shape as Release: paletteJson is auto-extracted from the
  // first track's cover art, colorSchemeJson is the artist's override (null = use the
  // extracted palette), visualPreset picks the background visualizer.
  paletteJson     String?
  colorSchemeJson String?
  visualPreset    VisualPreset @default(MINIMAL)

  items CollectionItem[]
  subscribers CollectionSubscription[]
  channelsUsingAsFallback Channel[] @relation("ChannelActiveFallbackCollection")

  @@index([userId, isPublic])
  @@index([userId, publicProfileOrder])
  @@schema("media")
}

model CollectionItem {
  id            String      @id @default(cuid())
  collectionId  String
  collection    Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  archiveItemId String?
  archiveItem   ArchiveItem? @relation(fields: [archiveItemId], references: [id], onDelete: SetNull)
  releaseId     String?
  release       Release?    @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  position      Int
  createdAt     DateTime    @default(now())
  // Who contributed this item — set for collaborative-playlist adds (and the
  // owner's own adds); null for pre-existing rows from before this field
  // existed. Powers the "participants" notification fan-out and the optional
  // note shown alongside the track.
  addedByUserId String?
  addedBy       User?       @relation("CollectionItemAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  addNote       String?

  @@unique([collectionId, position])
  @@index([collectionId, position])
  @@schema("media")
}

// A listener subscribing to a public playlist — surfaces it in their library
// and (future work) notifies them when the owner or a collaborator adds a
// track. Distinct from ArtistFollow: this follows one specific playlist, not
// everything an artist does.
model CollectionSubscription {
  userId       String
  collectionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, collectionId])
  @@index([collectionId])
  @@schema("media")
}

// ── Admin schema (M21) ────────────────────────────────────────────────────────

enum CronOutcome {
  SUCCESS
  ERROR

  @@schema("admin")
}

model CronRun {
  id           BigInt       @id @default(autoincrement())
  jobName      String
  startedAt    DateTime
  finishedAt   DateTime?
  outcome      CronOutcome?
  errorMessage String?

  @@index([jobName, startedAt(sort: Desc)])
  @@schema("admin")
}

enum SupportCategory {
  ENGAGEMENT_DISPUTE
  TECHNICAL
  FINANCIAL
  OTHER

  @@schema("admin")
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED

  @@schema("admin")
}

enum ContentReportTargetType {
  ARCHIVE_ITEM
  RELEASE
  CHANNEL
  COLLECTION
  MOTION_COMMENT

  @@schema("admin")
}

enum ContentReportReason {
  COPYRIGHT
  HARASSMENT
  SPAM
  ILLEGAL_CONTENT
  OTHER

  @@schema("admin")
}

enum ContentReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED

  @@schema("admin")
}

/// Anonymous report of a public upload/release/channel/collection — the platform-level
/// abuse-report queue that was previously entirely missing (only artist-side chat
/// moderation existed via ChatBan/ChannelModerator). No account required to report,
/// consistent with the platform's anonymous-by-default listener model; reporterIpHash
/// uses the same daily-rotating salt pattern as Download.byIpHash.
model ContentReport {
  id             BigInt                   @id @default(autoincrement())
  targetType     ContentReportTargetType
  targetId       String
  reason         ContentReportReason
  details        String?
  reporterIpHash String
  status         ContentReportStatus      @default(OPEN)
  resolvedById   String?
  resolvedBy     User?                    @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime                 @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@schema("admin")
}

enum ResolutionOutcome {
  PASSED
  FAILED
  DEFERRED

  @@schema("admin")
}

model SupportTicket {
  id           BigInt              @id @default(autoincrement())
  artistId     String?
  artist       User?               @relation("SupportTicketArtist", fields: [artistId], references: [id], onDelete: SetNull)
  contactEmail String?
  subject      String
  message      String
  category     SupportCategory
  status       SupportStatus       @default(OPEN)
  assignedToId String?
  assignedTo   User?               @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        SupportTicketNote[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@schema("admin")
}

model SupportTicketNote {
  id        BigInt        @id @default(autoincrement())
  ticketId  BigInt
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body      String
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt(sort: Asc)])
  @@schema("admin")
}

model BoardResolution {
  id           BigInt            @id @default(autoincrement())
  title        String
  body         String
  votedAt      DateTime
  outcome      ResolutionOutcome
  voteFor      Int
  voteAgainst  Int
  voteAbstain  Int
  createdById  String
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())

  @@index([votedAt(sort: Desc)])
  @@schema("admin")
}

model AnnualReport {
  id            BigInt   @id @default(autoincrement())
  year          Int      @unique
  storageKey    String
  generatedAt   DateTime @default(now())
  generatedById String
  generatedBy   User     @relation(fields: [generatedById], references: [id], onDelete: Cascade)

  @@schema("admin")
}

/// Board-triggered quarterly log of feature-request review outcomes (what got
/// voted in / declined / merged as duplicate that quarter). Mirrors AnnualReport's
/// shape but keyed on year+quarter instead of year alone.
model FeatureRequestQuarterlyReport {
  id            BigInt   @id @default(autoincrement())
  year          Int
  quarter       Int
  storageKey    String
  generatedAt   DateTime @default(now())
  generatedById String
  generatedBy   User     @relation(fields: [generatedById], references: [id], onDelete: Cascade)

  @@unique([year, quarter])
  @@schema("admin")
}

// Homepage news feed — board-authored platform announcements. authorName is a
// display-name snapshot at time of writing (not just a relation) so the byline
// survives even if the author's account is later renamed or removed.
model NewsPost {
  id          String    @id @default(cuid())
  headline    String
  summary     String
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
  @@schema("admin")
}

// ── Disco-widgets ────────────────────────────────────────────────────────────
// Dynamically-loaded, sandboxed third-party widgets — see docs/design for the
// full writeup. A widget's code never runs in the main app's origin; it's
// fetched by /widget-sandbox/[bundleHash] and executed inside a cookieless,
// sandboxed iframe with no allow-same-origin, talking to the host only over
// postMessage. bundleHash is pinned into that route's per-request CSP
// script-src, so an approved bundle can never be swapped without a version
// bump (which mints a new hash).

enum DiscoWidgetScope {
  LISTENER
  ARTIST
  ADMIN

  @@schema("core")
}

enum DiscoWidgetStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DISABLED

  @@schema("core")
}

model DiscoWidget {
  id              String            @id @default(cuid())
  slug            String            @unique
  scope           DiscoWidgetScope
  name            String
  description     String
  authorName      String
  authorUserId    String?
  authorUser      User?             @relation("DiscoWidgetAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  categories      String[]
  iconUrl         String?
  currentVersion  String
  bundleKey       String
  bundleHash      String
  bundleSizeBytes Int
  permissionsJson Json              @default("{}")
  status          DiscoWidgetStatus @default(DRAFT)
  moderationNote  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  versions DiscoWidgetVersion[]
  installs DiscoWidgetInstall[]

  @@index([scope, status])
  @@schema("core")
}

// One row per published bundle revision — kept even after currentVersion moves
// on, so an install with pinnedVersion set can keep resolving its own hash.
model DiscoWidgetVersion {
  id         String      @id @default(cuid())
  widgetId   String
  widget     DiscoWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  version    String
  bundleKey  String
  bundleHash String
  changelog  String?
  createdAt  DateTime    @default(now())

  @@unique([widgetId, version])
  @@schema("core")
}

// One install row covers all three scopes, discriminated by whichever of
// listenerUserId / channelId / adminSurface is set for a given row (enforced
// in the route handlers, not a DB constraint — mirrors this schema's existing
// style of application-level invariants over CHECK constraints).
model DiscoWidgetInstall {
  id             String      @id @default(cuid())
  widgetId       String
  widget         DiscoWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  listenerUserId String?
  listenerUser   User?       @relation("DiscoWidgetListenerInstall", fields: [listenerUserId], references: [id], onDelete: Cascade)
  channelId      String?
  channel        Channel?    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  adminSurface   String?
  pinnedVersion  String?
  position       Int         @default(0)
  enabled        Boolean     @default(true)
  configJson     Json        @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([widgetId, listenerUserId])
  @@unique([widgetId, channelId])
  @@unique([widgetId, adminSurface])
  @@index([listenerUserId, position])
  @@index([channelId, position])
  @@index([adminSurface, position])
  @@schema("core")
}

// ── Internet radio library ───────────────────────────────────────────────────
// Client-side only: a station's streamUrl is played directly in the listener's
// browser (same hls.js path as Tahti's own live streams) — Tahti never
// ingests, relays, or rebroadcasts third-party stream audio.

// Admin-curated catalog a user can one-click add from — see
// /admin/internet-radio ("internet radio source configuration"). streamUrl is
// often intentionally blank (rights/URL not supplied yet); a user filling it
// in on their own copy doesn't affect the shared preset.
model InternetRadioPreset {
  id             String   @id @default(cuid())
  name           String
  genre          String?
  description    String?
  iconUrl        String?
  /// Optional endpoint some stations expose for "what's on now" — display-only.
  programmingUrl String?
  streamUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("core")
}

// A user's own personal library entry — either copied from a preset (presetId
// set, further edits are theirs alone) or fully custom.
model InternetRadioStation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  presetId       String?
  name           String
  genre          String?
  description    String?
  iconUrl        String?
  programmingUrl String?
  streamUrl      String?
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, position])
  @@schema("core")
}

// ── Themes ────────────────────────────────────────────────────────────────
// A theme's CSS-variable JSON lives here only until it ships — "public" isn't
// a DB state: once a PR is merged, the theme lives in themes/registry.json +
// themes/<slug>.json in this repo, fetched live by GET /api/v1/themes/gallery.
// Merging the PR *is* the publish step; nothing here needs to flip afterward.

enum ThemeVisibility {
  PRIVATE
  PENDING_REVIEW
  REJECTED

  @@schema("core")
}

enum ThemePrStatus {
  NONE
  PENDING
  OPENED
  ERROR

  @@schema("core")
}

model Theme {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  varsJson       Json
  darkJson       Json
  visibility     ThemeVisibility @default(PRIVATE)
  moderationNote String?
  prStatus       ThemePrStatus   @default(NONE)
  prUrl          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([visibility])
  @@schema("core")
}
