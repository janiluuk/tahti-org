// ── Core schema ───────────────────────────────────────────────────────────────

model CloudImportJob {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source           CloudImportSource
  externalFileId   String
  fileName         String?
  archiveItemId    String?           @unique
  archiveItem      ArchiveItem?      @relation(fields: [archiveItemId], references: [id])
  status           CloudImportStatus @default(QUEUED)
  error            String?
  bytesTransferred BigInt?
  queuedAt         DateTime          @default(now())
  completedAt      DateTime?

  @@index([userId, queuedAt(sort: Desc)])
  @@schema("core")
}

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  emailVerifiedAt       DateTime?
  passwordHash          String?
  username              String     @unique
  displayName           String
  bio                   String?
  // Optional longer-form history ("+ Add full bio" on the artist profile
  // page) shown expanded below the short bio — unlike bio, never truncated
  // or used in card/list previews.
  fullBio               String?
  avatarUrl             String?
  // Static first-frame extracted client-side when avatarUrl is an animated
  // GIF — shown at rest on the profile hero, swapped for avatarUrl on hover
  // so the animation only plays while hovering. Null for a non-animated
  // avatar (the plain avatarUrl renders directly with no hover behavior).
  avatarPosterUrl       String?
  // Dominant palette extracted from avatarUrl (node-vibrant) — drives radio
  // calendar tint and other surfaces that want "colors from the profile pic".
  avatarPaletteJson     String?
  // Solid / gradient fill for avatar + profile cover when no photo (or under a logo).
  // JSON matching AvatarThemeSchema — defaults are resolved client/server from username.
  avatarThemeJson       String?
  // Optional PNG/WebP logo with alpha — overlaid on avatar and/or profile cover.
  logoUrl               String?
  // AVATAR | COVER | BOTH — where logoUrl is printed. Null when no logo.
  logoPlacement         String?
  socialLinks           Json?
  tipJarUrl             String?
  countryCode           String?
  pronouns              String?
  gender                String?    // free text, e.g. "Woman"/"Man"/"Non-binary" — null means declined to say
  defaultLocation       String?    // freeform "City, Country" — prefills venue creation, live-set tagging
  tier                  ArtistTier @default(FREE)
  isMember              Boolean    @default(false)
  isBoard               Boolean    @default(false)
  memberNumber          Int?       @unique
  memberSince           DateTime?
  publicAttribution     Boolean    @default(true)
  showJoinDate          Boolean    @default(true)
  showFollowers         Boolean    @default(true)
  showFollowing         Boolean    @default(true)
  showDailyListeners    Boolean    @default(true)
  chatEnabled           Boolean    @default(true)
  stripeCustomerId                  String?
  stripeMembershipSubscriptionId    String?  @unique
  stripeConnectAccountId            String?  @unique
  stripeConnectChargesEnabled   Boolean  @default(false)
  softTargetBytes               BigInt   @default(524288000)
  hiddenCeilingBytes    BigInt     @default(53687091200)
  storageUsedBytes      BigInt     @default(0)
  weeklyLiveSecondsUsed Int        @default(0)
  weeklyLiveResetAt     DateTime?
  mentionsEnabled         Boolean    @default(true)
  publicMentionsEnabled   Boolean    @default(false)
  // Defaults applied to new tracks/channel when created — each item can still be
  // overridden individually afterward (ArchiveItem.commentsEnabled / Channel.commentsEnabled).
  defaultTrackCommentsEnabled   Boolean @default(true)
  defaultChannelCommentsEnabled Boolean @default(true)
  // Default for new tracks' ArchiveItem.topListsEligible — inverted polarity
  // (opt OUT), so an artist who's opted out can still flip a specific track
  // back in via the per-track override.
  topListsOptOut                Boolean @default(false)
  // ground-rules.md /dashboard/settings/notifications instrument-pattern worked example
  notifyMoneyMovesEmail       Boolean @default(true)
  notifyMoneyMovesInApp       Boolean @default(true)
  notifyListenerActivityEmail Boolean @default(true)
  notifyWeeklyRecapEmail      Boolean @default(true)
  suspendedAt             DateTime?
  suspendReason           String?
  deletedAt               DateTime?
  mixcloudAccessTokenEnc   String?  // M7: OAuth access token (AES-GCM, same key as RTMP)
  bandcampAccessTokenEnc   String?  // Sprint 9: Bandcamp import OAuth
  soundcloudAccessTokenEnc String?  // Sprint 9: SoundCloud import OAuth
  googleDriveAccessTokenEnc  String?  // PLAT-080: Google Drive import OAuth
  googleDriveRefreshTokenEnc String?  // PLAT-083: encrypted refresh token
  musicbrainzAccessTokenEnc  String?  // MusicBrainz OAuth2 (profile scope — identifies the connected editor)
  musicbrainzRefreshTokenEnc String?
  musicbrainzUsername        String?  // MB editor name, shown as "Connected as X" — fetched via userinfo at connect time
  // Remembered choice for the publish-time "register this with MusicBrainz?" offer —
  // null = ask every time (no preference set yet), true/false = stop asking, do this.
  defaultRegisterToMusicbrainz Boolean?
  spotifyArtistId       String?  // mixed-source collections brief: resolved Spotify artist catalog ID for "Your tracks" — search itself uses an app-level token, no per-user OAuth
  mixcloudUsername      String?  // mixed-source collections brief: artist's own Mixcloud handle for "Your tracks" — Mixcloud's read API is public, no OAuth needed for catalog browsing
  hearthisUsername      String?  // same idea as mixcloudUsername, for hearthis.at's own public read API
  totpSecretEnc         String?  // 2FA: TOTP secret, AES-GCM encrypted at rest
  totpEnabledAt         DateTime? // null = 2FA off (default)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  sessions              Session[]
  apiTokens             ApiToken[]
  emailVerifications    EmailVerification[]
  totpBackupCodes       TotpBackupCode[]
  totpChallenges        TotpChallenge[]
  membership            Membership?
  channel               Channel?
  storageQuota          UserStorageQuota?
  motionsProposed       Motion[]
  votes                 Vote[]
  motionComments        MotionComment[]
  grants                GrantDisbursement[]
  fanTiers              FanTier[]
  fanSubsAsArtist       FanSubscription[]        @relation("ArtistFanSubs")
  fanSubsAsSubscriber   FanSubscription[]        @relation("SubscriberFanSubs")
  releases              Release[]
  revelatorRoyaltyReports RevelatorRoyaltyReport[]
  mixUploads            MixUpload[]
  cloudImportJobs       CloudImportJob[]
  newsletterSubscribers NewsletterSubscriber[]   @relation("ArtistSubscribers")
  newsletterDrafts      NewsletterDraft[]
  mentionsSent          Mention[]                @relation("MentionerMentions")
  mentionsReceived      Mention[]                @relation("MentionTarget")
  notificationsReceived Notification[]           @relation("NotificationRecipient")
  notificationsActedOn  Notification[]           @relation("NotificationActor")
  mentionsMuted         MentionMute[]            @relation("MuterMutes")
  mentionsMutedBy       MentionMute[]            @relation("MuteTarget")
  collections           Collection[]
  artistFollowers       ArtistFollow[]       @relation("ArtistFollowers")
  artistFollowing       ArtistFollow[]       @relation("ArtistFollowing")
  archiveItemLikes      ArchiveItemLike[]
  collectionSubscriptions CollectionSubscription[]
  collectionItemsAdded  CollectionItem[]         @relation("CollectionItemAddedBy")
  archiveItemReposts    ArchiveItemRepost[]
  trackReactions        TrackReaction[]
  conversationParticipations ConversationParticipant[]
  messagesSent          Message[]
  supportTickets        SupportTicket[]      @relation("SupportTicketArtist")
  supportTicketsAssigned SupportTicket[]     @relation("SupportAssignee")
  supportTicketNotes    SupportTicketNote[]
  contentReportsResolved ContentReport[]
  accountRestrictions        AccountRestriction[] @relation("AccountRestrictionUser")
  accountRestrictionsIssued  AccountRestriction[] @relation("AccountRestrictionIssuedBy")
  missedLiveShowFlagsResolved MissedLiveShowFlag[] @relation("MissedLiveShowFlagResolvedBy")
  boardResolutionsCreated BoardResolution[]
  annualReportsGenerated  AnnualReport[]
  socialConnections       SocialConnection[]
  socialPosts             SocialPost[]
  stashFiles              StashFile[]
  betaApplication         BetaApplication?
  betaApplicationsReviewed BetaApplication[] @relation("BetaReviewedBy")
  passwordSetups          PasswordSetup[]
  editorProjects          EditorProject[]
  moderatorOf             ChannelModerator[]
  greenRoomInvites        BroadcastGreenRoomInvite[]
  curatedRotationItemsAdded CuratedRotationItem[]
  radioSubmissionBatches    RadioTrackSubmissionBatch[] @relation("RadioSubmissionSubmitter")
  radioSubmissionsReviewed  RadioTrackSubmissionItem[]  @relation("RadioSubmissionReviewer")
  events                  ArtistEvent[]
  posts                   ArtistPost[]
  embeds                  ArtistEmbed[]
  comments                Comment[]
  featureRequestsProposed FeatureRequest[]        @relation("FeatureRequestProposer")
  featureRequestsReviewed FeatureRequest[]        @relation("FeatureRequestReviewer")
  featureRequestVotes     FeatureRequestVote[]
  featureRequestComments  FeatureRequestComment[] @relation("FeatureRequestCommentAuthor")
  featureRequestReportsGenerated FeatureRequestQuarterlyReport[]
  newsPostsAuthored              NewsPost[]
  discoWidgetsAuthored           DiscoWidget[]          @relation("DiscoWidgetAuthor")
  discoWidgetInstalls            DiscoWidgetInstall[]   @relation("DiscoWidgetListenerInstall")
  internetRadioStations          InternetRadioStation[]
  themes                         Theme[]
  integrationCredentials         IntegrationCredential[]

  @@schema("core")
