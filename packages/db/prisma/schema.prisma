// Simple "I'm playing here" listing on an artist's profile — freeform place/location,
// deliberately not linked to the structured Venue directory (that's a heavier, board-
// reviewed system; this is just the artist's own show calendar).
model ArtistEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  place     String
  location  String
  eventUrl  String?
  startAt   DateTime
  createdAt DateTime @default(now())

  @@index([userId, startAt])
  @@schema("core")
}

// Per-user storage quota for the R2-backed long-term store. One row per user,
// created lazily on first check (default 500MB free-tier allowance). usedBytes
// only counts objects that have actually been written through to R2 — local
// MinIO cache usage isn't quota'd, since it's transient (see [[hosting-decisions]]
// for the "R2 long-term, local disk hot cache only" split).
model UserStorageQuota {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotaBytes BigInt   @default(524288000)
  usedBytes  BigInt   @default(0)
  updatedAt  DateTime @updatedAt

  @@schema("core")
}

// Public artist updates/news feed, separate from live chat's ephemeral ChannelAnnouncement.
model ArtistPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  body      String
  images    String[] @default([])
  linkUrl   String?
  linkLabel String?
  // Defaults to createdAt (immediate publish). A future value schedules the
  // post — public routes filter on publishAt <= now, so "publishing" is a
  // pure query-time check, not a status flipped by a cron job.
  publishAt DateTime @default(now())
  createdAt DateTime @default(now())
  // Set once follower notifications have gone out — immediately for a post
  // published right away, or by post-publish-notify-cron once a scheduled
  // post's publishAt passes. Prevents double-notifying scheduled posts.
  notifiedAt DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, publishAt(sort: Desc)])
  @@index([notifiedAt, publishAt])
  @@schema("core")
}

// Embedded external tracks (SoundCloud, etc.) shown on the artist's profile.
model ArtistEmbed {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  url           String
  title         String?
  authorName    String?
  thumbnailUrl  String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@schema("core")
}

model EditorProject {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  archiveItemId String?
  timeline      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@schema("core")
}

model BetaApplication {
  id           String                @id @default(cuid())
  name         String
  email        String
  artistType   String
  links        String?
  message      String?
  source       String
  status       BetaApplicationStatus @default(PENDING)
  userId       String?               @unique
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?                 @relation("BetaReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([email])
  @@index([status, createdAt])
  @@schema("core")
}

