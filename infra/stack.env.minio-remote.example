# Remote MinIO storage node — copy to infra/stack.env.minio-remote on
# tahti.local (chmod 600).
#
# MINIO_SECRET_KEY must match vimage infra/stack.env's MINIO_SECRET_KEY
# exactly — this is meant to become a drop-in replacement for the main
# stack's minio service (same credentials, same buckets, once migrated),
# not a second independent MinIO with its own identity.

MINIO_ROOT_USER=tahti
MINIO_SECRET_KEY=YOUR_MINIO_SECRET

# Host ports MinIO listens on (S3 API / web console). Defaults match the
# main stack's *internal* container port (9000/9001) since tahti.local has
# no other MinIO on the box to collide with — unlike vimage, which remaps
# to 19000/19001 to avoid clashing with other lab services.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
