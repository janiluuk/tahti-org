# Remote transcode worker + GPU stem-separator — copy to
# infra/stack.env.worker-remote on vimage7 (chmod 600).
# Values must match the main stack on vimage (192.168.2.100).

# PgBouncer on vimage (host port 5432 or 16432 — check `docker port tahti-stack-pgbouncer-1`)
DATABASE_URL=postgresql://tahti:YOUR_POSTGRES_PASSWORD@192.168.2.100:5432/tahti?pgbouncer=true

REDIS_URL=redis://192.168.2.100:6379

MINIO_ENDPOINT=http://192.168.2.100:19000
MINIO_PUBLIC_ENDPOINT=http://192.168.2.100:19000
MINIO_ACCESS_KEY=tahti
MINIO_SECRET_KEY=YOUR_MINIO_SECRET

# Same as vimage infra/stack.env
INTERNAL_SECRET=YOUR_INTERNAL_SECRET
RTMP_KEY_ENC_KEY=YOUR_RTMP_KEY_ENC_KEY

# No STEM_SEPARATOR_URL here — it now runs colocated on this same host
# (GPU stem-separator, see infra/docker-compose.worker-remote.yml), reached
# at the fixed http://stem-separator:8090, not from this env file.

# Optional — match vimage stack.env if cloud import / AcoustID / R2 are enabled
ACOUSTID_API_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

WORKER_CONCURRENCY=4
