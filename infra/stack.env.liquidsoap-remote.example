# Remote Liquidsoap host hls-sync sidecar — copy to
# infra/stack.env.liquidsoap-remote on vimage4/vimage7 (chmod 600).
# Values must match the main stack on vimage (192.168.2.100). See
# infra/docker-compose.liquidsoap-remote.yml's header for what this does
# and, more importantly, what it does NOT do yet (no channel placement).

DATABASE_URL=postgresql://tahti:YOUR_POSTGRES_PASSWORD@192.168.2.100:5432/tahti?pgbouncer=true

REDIS_URL=redis://192.168.2.100:6379

MINIO_ENDPOINT=http://192.168.2.100:19000
MINIO_ACCESS_KEY=tahti
MINIO_SECRET_KEY=YOUR_MINIO_SECRET

INTERNAL_SECRET=YOUR_INTERNAL_SECRET

WORKER_CONCURRENCY=4
