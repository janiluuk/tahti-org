#!/usr/bin/liquidsoap
# Tahti v6 — per-channel template
# THE CORE PRODUCT MECHANIC LIVES IN THIS FILE.
# Each channel is a perpetual Liquidsoap process that:
#   - listens for a live Icecast source from the artist
#   - falls back to the channel's archive playlist when no live signal exists
#   - exposes HLS for listeners (live recording via ffmpeg sidecar — STREAM-004)
#   - optionally multistreams to RTMP destinations

settings.log.level := 3

# STREAM-013: custom "s3get:" protocol for archive/rotation playlist entries —
# the stdlib's http(s) protocol resolver (used whenever playlist() sees a plain
# http(s) URL) calls http.head/http.get.stream with the default
# normalize_url=true, which decodes %2F back to a literal `/` inside AWS
# SigV4's X-Amz-Credential query parameter — corrupting the exact byte sequence
# the signature was computed over, so MinIO rejects the request. Confirmed via
# direct testing: curl/wget/ffprobe fetch the identical presigned URL
# successfully; only Liquidsoap's own http.head/http.get.stream calls (used
# internally by libs/protocols.liq's protocol.http) failed, reproducibly, on a
# real production track (repeated "HTTP error 404 File Not Found" from
# input.http, traced back to protocol.http's http.get.stream call).
# protocol.add refuses to re-register an existing name ("Plugin already
# registered in protocols: http"), so this can't simply override "http"/"https"
# — instead it's a new scheme, "s3get:", that the API prefixes onto every
# presigned URL in the fallback.m3u it generates (see
# apps/api/src/routes/internal/channel-fallback.ts). Body is a straight copy of
# stdlib's protocol.http, minus the proto-prefixing (arg here is already the
# complete "https://..." URL) and with normalize_url=false added to both HTTP
# calls — Liquidsoap's own warning message names this exact parameter as the fix.
def protocol.s3get(~rlog, ~maxtime, arg) =
  uri = arg

  def log(~level, s) =
    rlog(s)
    log(label="procol.external", level=level, s)
  end

  # AWS SigV4 presigned URLs are method-specific — one signed for GetObject (GET)
  # is rejected by MinIO for a HEAD request (confirmed: consistently 403), so
  # stdlib's HEAD-then-sniff-content-type approach can never find an extension
  # here and always falls back to the generic ".osb", which ffmpeg's decoder
  # doesn't recognize — the download itself succeeds (confirmed via direct
  # testing) but decoding then fails on the unrecognized extension, producing
  # silence. Read the extension straight off the URL path instead (before the
  # `?`), which every archive/rotation entry actually has (see
  # apps/api/src/routes/internal/channel-fallback.ts).
  path_only = list.hd(default="", string.split(separator="\\?", uri))
  extname = file.extension(leading_dot=true, dir_sep="/", path_only)
  extname = extname == "" ? ".osb" : extname

  output = file.temp("liq-process", extname)
  file_writer = file.write.stream(output)
  timeout = maxtime - time()

  try
    response =
      http.get.stream(normalize_url=false, on_body_data=file_writer, timeout=timeout, uri)

    if response.status_code < 400 then
      [output]
    else
      log(level=3, "Error while fetching http data: #{response.status_code} - #{response.status_message}")
      []
    end
  catch err do
    log(level=3, "Error while fetching http data: #{err}")
    []
  end
end

protocol.add(
  temporary=true,
  syntax="s3get:<https-url>",
  doc="Download a presigned S3/MinIO URL without Liquidsoap's URL-normalizing http(s) resolver (STREAM-013)",
  "s3get",
  protocol.s3get
)

# --- Live input: HTTP pull (Icecast mount or RTMP edge-encoder relay — STREAM-002) ---
live_icecast = input.http("{{LIVE_INPUT_URL}}")
live_source = mksafe(live_icecast)

# --- Archive playlist (the fallback) ---
# STREAM-009: prefer local cache synced from MinIO; remote M3U until first warm completes.
archive_local_path = "/archive-cache/{{CHANNEL_ID}}/fallback.m3u"
archive_remote_url = "{{API_URL}}/internal/channels/{{CHANNEL_ID}}/fallback.m3u?secret={{INTERNAL_SECRET}}"
archive = if file.exists(archive_local_path) then
  playlist(
    # The API already orders the M3U entries per the channel's fallbackMode
    # (shuffle/ordered/time/name — an app-level vocabulary, not Liquidsoap's).
    # Passing that value straight through as Liquidsoap's own playlist mode
    # broke it outright: "shuffle" isn't a valid Liquidsoap mode ("normal",
    # "random", "randomize" are), so playlist() failed to initialize and the
    # whole fallback([live_source, archive, blank()]) chain fell through to
    # blank() — every channel not currently live was silently playing
    # silence instead of its archive. "normal" respects the order already
    # computed server-side.
    id="archive",
    mode="normal",
    reload=300,
    reload_mode="rounds",
    archive_local_path
  )
else
  playlist(
    # The API already orders the M3U entries per the channel's fallbackMode
    # (shuffle/ordered/time/name — an app-level vocabulary, not Liquidsoap's).
    # Passing that value straight through as Liquidsoap's own playlist mode
    # broke it outright: "shuffle" isn't a valid Liquidsoap mode ("normal",
    # "random", "randomize" are), so playlist() failed to initialize and the
    # whole fallback([live_source, archive, blank()]) chain fell through to
    # blank() — every channel not currently live was silently playing
    # silence instead of its archive. "normal" respects the order already
    # computed server-side.
    id="archive",
    mode="normal",
    reload=300,
    reload_mode="rounds",
    archive_remote_url
  )
end

# Manage panel transport controls (skip / previous): playlist(id="archive")
# above auto-registers "archive.skip" — that alone gives us forward-skip.
# "Previous" has no native Liquidsoap primitive on a playlist source, so a
# small request.queue sits ahead of archive; pushing a specific track's URL
# into it (jump_queue.push, sent by the orchestrator) plays that one track
# next, then falls back through to the normal archive rotation once it
# finishes. request.queue also auto-registers under its id, so no extra
# server.register is needed for the push itself.
jump_queue = request.queue(id="jump_queue")
rotation = fallback(track_sensitive=false, [jump_queue, archive])

# STREAM-012: rotation now-playing — captured before crossfade/normalize/delay so
# "filename" is the least-mutated pointer back to the exact playing file. Read via
# the "now_playing" telnet command below; the orchestrator resolves it to a real
# ArchiveItem (title/artist/artwork) rather than trusting on-disk ID3 tags. Bound
# to the combined jump_queue+archive source so a "previous"-jumped track's title
# updates now-playing too, not just the normal archive rotation.
rotation_meta = ref([])
rotation = source.on_metadata(rotation, fun (m) -> rotation_meta := m)

rotation = crossfade(duration=3., rotation)
rotation = normalize(target=-14., rotation)
# ARTIST-003: buffer archive before fallback switch so first listener does not hit an empty segment.
rotation = delay(3., rotation)

# --- THE MAGIC: live-or-archive fallback ---
# track_sensitive=false means: switch immediately when live ends, not at the next track boundary.
# The third source (blank) is a safety net so the chain never dies if both fail.
radio = fallback(
  track_sensitive=false,
  [live_source, rotation, blank()]
)

# Manage panel "stop" — pauses the rotation without ending the live broadcast
# or killing the container (graceful_shutdown does that, and is a much bigger
# hammer: it tears the whole process down). "resume" undoes it. Live input
# still takes priority over the paused state, matching the normal fallback —
# an artist going live isn't blocked by a listener having paused the rotation.
paused = ref(false)

# --- STREAM-010: graceful shutdown fade (orchestrator sends telnet graceful_shutdown) ---
shutting_down = ref(false)

def start_graceful_shutdown(_) =
  shutting_down := true
  thread.pause({{LIQUIDSOAP_FADE_SEC}}.)
  shutdown(code=0)
  "ok"
end

settings.server.telnet.set(true)
# Default bind (127.0.0.1) only accepts connections from inside this same
# container — the orchestrator reaches this port from its own container over
# the docker network, not published to the host, so 0.0.0.0 stays internal-only.
settings.server.telnet.bind_addr.set("0.0.0.0")
settings.server.telnet.port.set({{LIQUIDSOAP_TELNET_PORT}})
server.register(
  "graceful_shutdown",
  description="Fade out audio then exit (STREAM-010)",
  start_graceful_shutdown
)
server.register(
  "now_playing",
  description="Current rotation-source metadata initial_uri (STREAM-012)",
  fun (_) -> begin
    m = rotation_meta()
    # "filename" is a local decode temp file for HTTP-sourced entries — useless
    # for identifying the track. "initial_uri" carries the real request (wrapped
    # in an annotate:...:URL prefix for playlist entries with inline metadata),
    # confirmed by dumping every metadata key against a real production track.
    m["initial_uri"] ?? ""
  end
)
server.register(
  "pause",
  description="Manage panel: pause the rotation (live input still takes priority)",
  fun (_) -> begin paused := true "ok" end
)
server.register(
  "resume",
  description="Manage panel: resume the rotation after pause",
  fun (_) -> begin paused := false "ok" end
)

radio_out = switch(
  track_sensitive=false,
  [
    ({ shutting_down() }, fade.out(type="log", duration={{LIQUIDSOAP_FADE_SEC}}., radio)),
    ({ paused() and not source.is_ready(live_source) }, blank()),
    ({ true }, radio)
  ]
)

# --- Live recording: ffmpeg sidecar (STREAM-004) spawned by orchestrator ---
# Reads Icecast or RTMP ingest directly; survives Liquidsoap restarts.

# output.file.hls doesn't create its target directory itself.
if not file.exists("/hls/{{CHANNEL_ID}}") then
  file.mkdir("/hls/{{CHANNEL_ID}}")
end

# --- HLS output for listeners (M20: dual-bitrate — free MP3, paid FLAC manifest paths) ---
output.file.hls(
  playlist="stream.m3u8",
  segments=4,
  segment_duration=4.,
  segments_overhead=10,
  # Same filesystem as the target dir, or segment writes fall back to a slow
  # copy instead of an atomic rename.
  temp_dir="/hls/{{CHANNEL_ID}}",
  "/hls/{{CHANNEL_ID}}",
  [
    ("stream-mp3-192", %ffmpeg(format="mpegts", %audio(codec="libmp3lame", b="192k", ar=44100, ac=2))),
    ("stream-flac", %ffmpeg(format="mpegts", %audio(codec="flac", samplerate=44100, channels=2)))
  ],
  radio_out
)

# --- Now-playing metadata endpoint ---
# Internal-only: orchestrator scrapes for "what's playing right now"
output.harbor(
  %mp3(bitrate=64),
  port={{HARBOR_NOWPLAYING_PORT}},
  mount="/now",
  radio_out
)

{{#RTMP_TARGETS}}
# --- RTMP push to each enabled multistream target ---
# The content of this block is fully generated by spawnLiquidsoapContainer() in
# services/orchestrator/src/liquidsoap.ts (one output.url(...) per enabled RtmpTarget,
# muxed with a cover-art + title video track from cover-cache.ts) — nothing here is
# parsed as a real conditional — the surrounding markers only mark where that
# generated text gets spliced in (and get stripped entirely when there are no
# enabled targets), since the render step is plain string replacement, not a
# templating engine. (Written without the literal marker tokens here, on purpose —
# spawnLiquidsoapContainer's non-greedy strip regex would otherwise match this
# comment's mention of them instead of the real closing marker below.)
{{/RTMP_TARGETS}}
